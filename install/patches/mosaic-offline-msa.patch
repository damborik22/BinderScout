diff --git a/src/mosaic/models/boltz2.py b/src/mosaic/models/boltz2.py
index 1ce98b9..3892090 100644
--- a/src/mosaic/models/boltz2.py
+++ b/src/mosaic/models/boltz2.py
@@ -46,7 +46,11 @@ def chain_yaml(chain_name: str, chain: TargetChain) -> str:
     raw = f"""  - {chain.polymer_type.lower()}:
         id: [{chain_name}]
         sequence: {chain.sequence}"""
