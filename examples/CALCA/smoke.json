{
  "config_version": 1,
  "_comment": "BinderScout smoke test - the smallest campaign that still exercises every design tool end to end. Replay with: binderscout configure --config examples/CALCA/smoke.json (from any directory). Relative paths in this file are relative to the BinderScout checkout, not the cwd (path_base 'repo', the default; a config.json written into a run folder says path_base 'config' instead). Every tool is bounded: BindCraft 2's number_of_final_designs is a quota of ACCEPTED designs, so bindcraft2_max_trajectories is what actually caps it.",
  "tools_enabled": {
    "bindcraft": true,
    "bindcraft2": true,
    "boltzgen": true,
    "mosaic": true,
    "pxdesign_local": true,
    "proteina_complexa": true,
    "rfd3": true,
    "protein_hunter": true,
    "evaluator": true
  },
  "cfg": {
    "name": "CALCA_smoke",
    "run_dir": "runs/CALCA_smoke",
    "target_pdb_src": "examples/CALCA/target.pdb",
    "target_sequence": "EDEARLLLAALVQDYVQMKASELEQEQEREGS",
    "chains": "A",
    "hotspots": null,
    "rfd3_hotspots": "5,9,12",

    "min_length": 20,
    "max_length": 30,
    "n_designs": 1,

    "filter_preset": "no_filters",
    "advanced_preset": "default_4stage_multimer",

    "bindcraft_n_designs": 1,
    "bindcraft2_n_designs": 1,
    "bindcraft2_max_trajectories": 3,
    "boltzgen_budget": 1,
    "mosaic_n_designs": 1,
    "pxdesign_binder_length": 25,
    "pxdesign_n_samples": 2,
    "complexa_n_designs": 2,
    "complexa_replicas": 1,
    "rfd3_n_designs": 1,
    "rfd3_batch_size": 1,
    "rfd3_diffusion_steps": 20,
    "rfd3_mpnn_samples": 1,
    "protein_hunter_n_designs": 3,
    "protein_hunter_num_cycles": 3,
    "protein_hunter_iptm_threshold": 0.5,

    "use_boltz": true,
    "use_af3": true,
    "use_esmfold2": true,
    "primary_engine": "boltz",
    "use_soluprot": true
  }
}
