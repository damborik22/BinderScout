# Tool directories — cloned fresh by install.sh
BindCraft/
# BindCraft 2 is staged here by the installer, never committed. Its licence is
# its own (BindCraft2 Source-Available, hosting-restricted), not this repo's
# MIT, so we do not vendor it -- the same posture as the AF3 weights. Without
# this line a plain `git add -A` stages 157 of its source files.
BindCraft2/
BoltzGen/
Mosaic/
PXDesign/
Proteina-Complexa/
Protein-Hunter/
LigandMPNN/
rf_diffusion_all_atom/

# `BC2/` is the upstream directory name; same treatment as BindCraft2/ above.
BC2/

# Local Miniforge3 installation (standalone mode)
conda/

# Local shortcuts (standalone mode)
bin/

# Installer logs — ephemeral, can be large.
# NOT `install*.log`: that glob has no slash, so git matches it against the
# basename, and `install*` requires the name to START with "install".
# af3_install.log carries it in the middle and escaped for months.
*install*.log

# Claude Code internal files (settings, history, etc.) — but DO track .claude/skills/
.claude/*
!.claude/skills/

# Machine-local Claude Code notes (per-workstation setup, IPs, key paths) — never shared
CLAUDE.local.md
docs/local/

# Docker build cache / test artifacts
.docker-iidfile

# Run outputs — generated per-experiment
runs/
refold_boltz2/
# Shared target-MSA cache written by the refold engines at runtime
# (ColabFold hits, keyed by target-sequence hash).
msa_cache/
# Refold resume checkpoints and scratch outputs, written to the CWD by the
# refold engines. These four are all {"interrupted": true} -- the residue of
# runs killed by the GB10 guard and the 2026-09-21 freeze.
checkpoint_refold_*.json
refold_designs.csv
refold_designs.txt

# RFD3 / foundry checkpoints — fetched by `foundry install` (~2.5 GB), not part of repo
weights/

# AlphaFold 3 model weights — personal, DO NOT commit
af3.bin
*.af3.bin*

# RFD3 / ProteinMPNN foundry checkpoints (fetched by 'foundry install'; 2.5GB+)
weights/foundry/

# Evaluator build / runtime artefacts
__pycache__/
*.egg-info/
Evaluator/envs/mosaic_venv_path
.venv/
# AlphaFold 3 clone dir — installed locally on Spark, not part of repo
alphafold3/

# Investigation analysis artifacts (regenerated by notebooks/_analysis.py)
notebooks/_artifacts/

# SoluProt USEARCH: the installer source-builds usearch12 (GPLv3) into this
# directory, so none of it is tracked — an MIT repo must not redistribute the
# binaries (they were removed in 2ae1bdb) and a bare arch-ambiguous 'usearch'
# once clobbered the x86 build across a branch merge.
Evaluator/tools/soluprot/usearch
Evaluator/tools/soluprot/usearch.x86_64
Evaluator/tools/soluprot/usearch.aarch64
Evaluator/tools/soluprot/usearch12-src/

# superpowers SDD scratch workspace
.superpowers/

# Benchmark label registry (2.0 Part Y). The public repo carries everything
# needed to AUDIT a result and nothing that gives away the answer key: the
# per-pool MANIFEST.json (provenance, source DOI, row count, column schema,
# SHA-256 of the label file) is tracked, while the label rows themselves live
# in a private store that the loader resolves by checksum. These are our
# benchmarks, and publishing them is irreversible on a public repo — so the
# ignore is written BEFORE the directory exists, and it fails closed: every
# data format is ignored and only the two metadata files are negated.
Evaluator/benchmarks/**/*.csv
Evaluator/benchmarks/**/*.tsv
Evaluator/benchmarks/**/*.parquet
Evaluator/benchmarks/**/*.npy
Evaluator/benchmarks/**/*.npz
Evaluator/benchmarks/**/*.pkl
Evaluator/benchmarks/**/*.json
!Evaluator/benchmarks/**/MANIFEST.json
!Evaluator/benchmarks/SCHEMA.json
